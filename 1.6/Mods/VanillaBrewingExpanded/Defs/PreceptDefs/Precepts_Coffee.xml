<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<IssueDef>
		<defName>AM_CoffeeDrinking</defName>
		<label>coffee drinking</label>
		<iconPath>UI/Issues/AM_Coffee</iconPath>
	</IssueDef>
	
	<HistoryEventDef>
		<defName>AM_DrankCoffee</defName>
		<label>drank coffee</label>
	</HistoryEventDef>
	<HistoryEventDef>
		<defName>AM_DrankSpecialtyCoffee</defName>
		<label>drank specialty coffee</label>
	</HistoryEventDef>
	<!-- Precepts -->
	<PreceptDef>
		<defName>AM_CoffeeDrinking_Required</defName>
		<issue>AM_CoffeeDrinking</issue>
		<label>required</label>
		<description>Coffee is more than just a drink; it is a moment of energy, focus, and ritual. The consumption of coffee is a sacred obligation.\n\n&lt;color=#E5E54C&gt;Unlocks need:&lt;/color&gt;\n - Coffee drinking need.\n\n&lt;color=#E5E54C&gt;Gameplay effect:&lt;/color&gt;\n - Bear in mind this precept has a minimum expectation required. Moderate expectations or higher are needed for the "Coffee" need to show up.\n- Coffee and iced coffee fill the need by 0.4, specialty coffee (any in VE Brewing - Coffees and Teas) by 0.5</description>
		<impact>Medium</impact>
		<associatedMemes>
			<li>AM_CoffeePrimacy</li>
		</associatedMemes>
		<requiredMemes>
			<li>AM_CoffeePrimacy</li>
		</requiredMemes>
		<comps>
			
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>AM_DrankCoffee</eventDef>
				<thought>AM_CoffeeDrinking_Required_DrankCoffee</thought>
			</li>
			<li Class="AlphaMemes.PreceptComp_IncreaseCoffeeNeed">
				<eventDef>AM_DrankCoffee</eventDef>
				<needGain>0.4</needGain>
			</li>
			<li Class="PreceptComp_SelfTookMemoryThought">
				<eventDef>AM_DrankSpecialtyCoffee</eventDef>
				<thought>AM_CoffeeDrinking_Required_DrankSpecialtyCoffee</thought>
			</li>
			<li Class="AlphaMemes.PreceptComp_IncreaseCoffeeNeed">
				<eventDef>AM_DrankSpecialtyCoffee</eventDef>
				<needGain>0.5</needGain>
			</li>
		</comps>
	</PreceptDef>
	
	<ThoughtDef>
		<defName>AM_CoffeeDrinking_Required_DrankCoffee</defName>
		<durationDays>1</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>drank coffee</label>
				<description>That coffee was refreshing and invigorating. A nice moment of energy and focus.</description>
				<baseMoodEffect>4</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	<ThoughtDef>
		<defName>AM_CoffeeDrinking_Required_DrankSpecialtyCoffee</defName>
		<durationDays>1</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>drank specialty coffee</label>
				<description>That specialty coffee was exquisite—rich, aromatic, and exactly what I needed.</description>
				<baseMoodEffect>5</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
</Defs>